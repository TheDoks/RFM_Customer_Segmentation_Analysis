      <aliases enabled='yes' />
      <column caption='Frequency Group' datatype='string' name='[Calculation_1290034031689729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Frequency] = 1 THEN &quot;1 Purchase&quot;&#13;&#10;ELSEIF [Frequency] &lt;= 3 THEN &quot;2–3 Purchases&quot;&#13;&#10;ELSEIF [Frequency] &lt;= 5 THEN &quot;4–5 Purchases&quot;&#13;&#10;ELSEIF [Frequency] &lt;= 10 THEN &quot;6–10 Purchases&quot;&#13;&#10;ELSE &quot;11+ Purchases&quot;&#13;&#10;END' />
      </column>
      <column caption='Monetary Group' datatype='string' name='[Calculation_1290034032537602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Monetary] &lt;= 250 THEN &quot;£0–£250&quot;&#13;&#10;ELSEIF [Monetary] &lt;= 500 THEN &quot;£251–£500&quot;&#13;&#10;ELSEIF [Monetary] &lt;= 1000 THEN &quot;£501–£1,000&quot;&#13;&#10;ELSEIF [Monetary] &lt;= 2500 THEN &quot;£1,001–£2,500&quot;&#13;&#10;ELSE &quot;£2,501+&quot;&#13;&#10;END' />
      </column>
      <column caption='RFM Highlight' datatype='string' name='[Calculation_1290034478219267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [RFM Score Set] THEN &quot;Selected RFM Score&quot;&#13;&#10;ELSE &quot;Other RFM Scores&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Customer Count' datatype='integer' name='[Calculation_1290034660077572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    COUNTD([CustomerID])&#13;&#10;ELSE&#13;&#10;    COUNTD(&#13;&#10;        IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Selected Monetary Value' datatype='real' name='[Calculation_1290034663272454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    SUM([Monetary])&#13;&#10;ELSE&#13;&#10;    SUM(&#13;&#10;        IF [RFM Score Set] THEN [Monetary] END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Selected Average Customer Value' datatype='real' name='[Calculation_1290034663514119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    AVG([Monetary])&#13;&#10;ELSE&#13;&#10;    AVG(&#13;&#10;        IF [RFM Score Set] THEN [Monetary] END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Selected Average Frequency' datatype='real' name='[Calculation_1290034663624712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    AVG([Frequency])&#13;&#10;ELSE&#13;&#10;    AVG(&#13;&#10;        IF [RFM Score Set] THEN [Frequency] END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Selected Average Recency' datatype='real' name='[Calculation_1290034663706633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    AVG([Recency])&#13;&#10;ELSE&#13;&#10;    AVG(&#13;&#10;        IF [RFM Score Set] THEN [Recency] END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Customer ID' datatype='integer' name='[CustomerID]' role='dimension' type='ordinal' />
      <column caption='F Score' datatype='integer' name='[F_Score]' role='measure' type='quantitative' />
      <column caption='M Score' datatype='integer' name='[M_Score]' role='measure' type='quantitative' />
