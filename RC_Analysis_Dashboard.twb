    <worksheet name='KPI-Average Customer Value'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='banton sans book'>Average Customer Value</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customers (Cust_Seg_Analysis)' name='federated.08mfp5118jzcni1gi1ep411dg20t' />
          </datasources>
          <datasource-dependencies datasource='federated.08mfp5118jzcni1gi1ep411dg20t'>
            <column caption='Selected Average Customer Value' datatype='real' name='[Calculation_1290034663514119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(&#13;&#10;    IF [RFM Score Set] THEN [CustomerID] END&#13;&#10;) = 0&#13;&#10;THEN&#13;&#10;    AVG([Monetary])&#13;&#10;ELSE&#13;&#10;    AVG(&#13;&#10;        IF [RFM Score Set] THEN [Monetary] END&#13;&#10;    )&#13;&#10;END' />
            </column>
            <column caption='Customer ID' datatype='integer' name='[CustomerID]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Monetary]' role='measure' type='quantitative' />
            <column caption='RFM Score' datatype='string' name='[RFM_Score]' role='dimension' type='nominal' />
            <column-instance column='[Monetary]' derivation='Avg' name='[avg:Monetary:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1290034663514119]' derivation='User' name='[usr:Calculation_1290034663514119:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
